        function getSimpleProductForm(productName: string) {
            return `
                <h3 style="color: var(--llt-accent-mid);">Prilagodi ${productName}</h3>
                <form id="customSimpleForm" data-product-name="${productName}">
                    <div class="mb-3">
                        <label class="form-label" style="color: var(--llt-accent-dark);">Boja:</label>
                        <input type="hidden" name="boja" id="bojaInput">
                        <div class="selection-grid mt-2">
                            <button type="button" class="option-card" data-field="boja" data-value="Gold">Gold</button>
                            <button type="button" class="option-card" data-field="boja" data-value="Silver">Silver</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="color: var(--llt-accent-dark);">Napomena:</label>
                        <textarea name="napomena" class="form-control" rows="3" placeholder="Dodatna napomena vezana za ovaj proizvod" style="border: 1px solid var(--llt-accent-mid);"></textarea>
                    </div>
                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-cart-plus me-2"></i>Dodaj u košaricu
                        </button>
                        <button type="button" class="btn btn-secondary w-100 cancel-modal-btn">
                            <i class="fas fa-times me-2"></i>Otkaži
                        </button>
                    </div>
                </form>
            `;
        }

        function validateRequiredImageSelections(form: HTMLFormElement): boolean {
            const missingInput = Array.from(form.querySelectorAll<HTMLInputElement>('[data-required-image]')).find(input => {
                const conditionalSection = input.closest<HTMLElement>('#krunicaSection');
                return !input.value && conditionalSection?.style.display !== 'none';
            });
            if (!missingInput) return true;

            form.querySelector<HTMLElement>(`.option-image[data-field="${missingInput.name}"]`)?.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
            });
            alert(`Odaberite sliku za polje: ${missingInput.dataset.requiredImage}.`);
            return false;
        }

        function submitKrsniSet(event: SubmitEvent) {
            event.preventDefault();
            const form = event.currentTarget;
            if (!(form instanceof HTMLFormElement)) return;
            if (!validateRequiredImageSelections(form)) return;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData);
            cart.push({product: 'Krsni Set', ...data});
            updateCartSummary();
            closeCustomizationModal();
        }

        function submitViktorija(event: SubmitEvent) {
            event.preventDefault();
            const form = event.currentTarget;
            if (!(form instanceof HTMLFormElement)) return;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData);
            cart.push({product: 'Viktorija Naušnice', ...data});
            updateCartSummary();
            closeCustomizationModal();
        }

        function submitSimpleProduct(event: SubmitEvent, productName: string) {
            event.preventDefault();
            const form = event.currentTarget;
            if (!(form instanceof HTMLFormElement)) return;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData);
            cart.push({product: productName, ...data});
            updateCartSummary();
            closeCustomizationModal();
        }

        function closeCustomizationModal() {
            getElement('customizationModal')?.classList.remove('active');
            document.body.style.overflow = 'auto';
            const modalContent = getElement('modalContent');
            if (modalContent) modalContent.innerHTML = '';
        }

        function updateCartSummary() {
            const textarea = getElement<HTMLTextAreaElement>('orderSummary');
            const cartSection = getElement('cartSection');
            if (!textarea || !cartSection) return;
            if (!cart.length) {
                textarea.value = '';
                cartSection.style.display = 'none';
                return;
            }

            let summary = '';
            cart.forEach((item, index) => {
                summary += `PROIZVOD ${index + 1}: ${item.product}\n`;
                for (const [key, value] of Object.entries(item)) {
                    if (key !== 'product' && value) {
                        summary += `  ${key}: ${value}\n`;
                    }
                }
                summary += '\n';
            });
            textarea.value = summary;
            cartSection.style.display = 'block';
        }

        function clearCart() {
            cart.length = 0;
            updateCartSummary();
        }

        catalogWindow.clearCart = clearCart;

        document.querySelectorAll('.customize-btn').forEach(btn => {
            btn.addEventListener('click', function(this: HTMLElement) {
                const productId = this.dataset.productId;
                const productName = this.dataset.productName ?? '';
                if (productId === 'krsni-setovi') {
                    openKrsniSetModal();
                } else if (productId === 'nausnice') {
                    openViktorijaNausnicasModal();
                } else {
                    openSimpleProductModal(productName);
                }
            });
        });

        getRequiredElement('sendCartEmailBtn').addEventListener('click', () => catalogWindow.sendCartEmail?.());
        getRequiredElement('clearCartBtn').addEventListener('click', clearCart);

        getRequiredElement('customizationModal').addEventListener('click', function(this: HTMLElement, e: MouseEvent) {
            if (e.target === this) closeCustomizationModal();
        });
    </script>

