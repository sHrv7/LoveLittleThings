---
import Layout from '../layouts/Layout.astro';

const categories = [
    {
        id: 'krsni-setovi',
        name: 'Krsni setovi',
        description: 'Kompletni setovi za krštenja',
        price: '45-80 €',
    },
    // {
    //     id: 'nausnice',
    //     name: 'Naušnice',
    //     description: 'Različiti stilovi naušnica',
    //     price: '10-35 €',
    // },
];
---

<Layout title="Katalog">
    <div class="container py-5">
        <h1 class="text-center mb-2 fw-bold" style="color: var(--llt-accent-dark);">Katalog Proizvoda</h1>
        <p class="text-center mb-5" style="color: var(--llt-accent-dark);">Pronađite savršen proizvod ili ga prilagodite po svojoj želji</p>

        <!-- Products Grid -->
        <div class="row g-4" id="products-grid">
            {categories.map(category => (
                <div class="col-md-6 col-lg-4 product-item" data-category={category.id}>
                    <div class="product-card">
                        <img src={`../images/${category.name.replace('š', 's').replace('ć', 'c').replace('č', 'c')}.jpg`} 
                             alt={category.name}
                             class="product-img"
                             style="width: 100%; height: 300px; object-fit: cover; border-radius: 10px; display: block; margin-bottom: 12px;"/>
                        <div class="product-title" style="color: var(--llt-accent-dark);">{category.name}</div>
                        <p class="mb-2" style="color: var(--llt-accent-dark);">{category.description}</p>
                        <p class="fw-bold mb-3" style="color: var(--llt-accent-mid);">Cijena: {category.price}</p>
                        <div class="d-flex gap-2">
                            <button 
                                type="button" 
                                class="btn w-100 customize-btn"
                                data-product-id={category.id}
                                data-product-name={category.name}
                                style="background: var(--llt-accent-mid); border: none; color: white;"
                            >
                                <i class="fas fa-paint-brush me-2"></i>Prilagodi
                            </button>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <div id="cartSection" class="mt-5" style="display: none; background: rgba(255, 240, 247, 0.9); padding: 20px; border-radius: 18px; border: 1px solid rgba(188, 136, 198, 0.35);">
            <h2 class="fw-bold" style="color: var(--llt-accent-dark);">Vaša košarica za prilagodbu</h2>
            <p class="text-muted">Ovdje su svi proizvodi koje ste dodali s detaljima prilagodbe. Pošaljite upit kad budete spremni.</p>
            <div class="mb-3">
                <label for="customerNameInput" class="form-label" style="color: var(--llt-accent-dark);">Ime i prezime</label>
                <input type="text" id="customerNameInput" class="form-control" autocomplete="name" required placeholder="Unesite ime i prezime" style="border: 1px solid var(--llt-accent-mid);">
            </div>
            <div class="mb-3">
                <label for="customerEmailInput" class="form-label" style="color: var(--llt-accent-dark);">E-adresa za odgovor</label>
                <input type="email" id="customerEmailInput" class="form-control" autocomplete="email" required placeholder="Unesite svoju e-adresu" style="border: 1px solid var(--llt-accent-mid);">
            </div>
            <textarea id="orderSummary" class="form-control" rows="8" readonly style="border: 1px solid var(--llt-accent-mid); background: #faf4fb; min-height: 220px;"></textarea>
            <div class="mb-3 mt-3">
                <label for="orderNoteInput" class="form-label" style="color: var(--llt-accent-dark);">Napomena (nije obavezno)</label>
                <textarea id="orderNoteInput" class="form-control" rows="3" placeholder="Upišite dodatnu napomenu" style="border: 1px solid var(--llt-accent-mid);"></textarea>
            </div>
            <div class="delivery-selection mt-4">
                <h3 class="h5" style="color: var(--llt-accent-dark);">Način dostave</h3>
                <input type="hidden" id="deliveryMethodInput" name="nacin_dostave" value="Boxnow">
                <div class="delivery-grid d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="option-card delivery-option selected" data-field="deliveryMethod" data-value="Boxnow" style="min-width: 140px;">Boxnow paketomat 4€</button>
                </div>
                <div class="mt-3">
                    <label for="deliveryAddressInput" class="form-label" style="color: var(--llt-accent-dark);">Adresa BoxNow paketomata</label>
                    <input type="text" id="deliveryAddressInput" class="form-control" placeholder="Odaberite BoxNow paketomat" readonly required style="border: 1px solid var(--llt-accent-mid);">
                </div>
                <div class="d-flex gap-2 flex-wrap mt-3">
                    <button type="button" class="btn btn-outline-primary boxnow-widget-button" id="chooseLockerBoxnowButton" style="display:inline-flex;">Odaberi BoxNow paketomat</button>
                </div>
                <div id="boxnowmap" class="mt-3" style="min-height: 220px;"></div>
            </div>
            <div class="d-flex gap-2 mt-3 flex-wrap">
                <button id="sendCartEmailBtn" type="button" class="btn btn-success">
                    <i class="fas fa-envelope me-2"></i>Pošalji Upit
                </button>
                <button id="clearCartBtn" type="button" class="btn btn-secondary">
                    <i class="fas fa-trash me-2"></i>Očisti košaricu
                </button>
            </div>
        </div>

        <!-- Empty State -->
        <div class="text-center py-5" id="empty-state" style="display: none;">
            <i class="fas fa-inbox" style="font-size: 3rem; color: #ddd; margin-bottom: 15px;"></i>
            <p>Nema proizvoda u ovoj kategoriji</p>
        </div>
    </div>

    <!-- Customization Modal -->
    <div id="customizationModal" class="modal">
        <div class="modal-content">
            <div id="modalContent"></div>
        </div>
    </div>

    <script is:inline src="../scripts/katalog-extras.js"></script>
    
    <script>
        const baseUrl = '../';
        type CartItem = { product: string } & Record<string, FormDataEntryValue>;
        type CatalogWindow = Window & {
            cart?: CartItem[];
            clearCart?: () => void;
            sendCartEmail?: () => void;
        };

        const cart: CartItem[] = [];
        const catalogWindow = window as CatalogWindow;
        catalogWindow.cart = cart;

        function getElement<T extends HTMLElement>(id: string): T | null {
            return document.getElementById(id) as T | null;
        }

        function getRequiredElement<T extends HTMLElement>(id: string): T {
            const element = getElement<T>(id);
            if (!element) throw new Error(`Required page element not found: ${id}`);
            return element;
        }

        // Colour and Option Lists
        const Colors = {
            bowRibbon: [
                { name: 'Svijetlo roza', value: 'Svijetlo roza' },
                { name: 'Tamno roza', value: 'Tamno roza' },
                { name: 'Svijetlo zelena', value: 'Svijetlo zelena' },
                { name: 'Zlatna', value: 'Zlatna' },
                { name: 'Ljubicasta', value: 'Ljubicasta' },
                { name: 'Lila', value: 'Lila' },
                { name: 'Kraljevsko zelena', value: 'Kraljevsko zelena' },
                { name: 'Bijela', value: 'Bijela' },
                { name: 'Vanilija', value: 'Vanilija' },
                { name: 'Krem', value: 'Krem' },
                { name: 'Smeda', value: 'Smeda' },
                { name: 'Maslinasta', value: 'Maslinasta' },
                { name: 'Svijetlo plava', value: 'Svijetlo plava' },
                { name: 'Tamno plava', value: 'Tamno plava' }
            ],
            metallic: [
                { name: 'Srebrna', value: 'Srebrna' },
                { name: 'Zlatna', value: 'Zlatna' },
                { name: 'Rose gold', value: 'Rose gold' }
            ],
            metal: [
                { name: 'Gold', value: 'Gold' },
                { name: 'Silver', value: 'Silver' }
            ]
        };

        const Fonts = [
            { name: 'Arial', family: 'Arial' },
            { name: 'Verdana', family: 'Verdana' },
            { name: 'Times New Roman', family: 'Times New Roman' },
            { name: 'Georgia', family: 'Georgia' },
            { name: 'Courier New', family: 'Courier New' },
            { name: 'Tahoma', family: 'Tahoma' },
            { name: 'Trebuchet MS', family: 'Trebuchet MS' },
            { name: 'Impact', family: 'Impact' },
            { name: 'Comic Sans MS', family: 'Comic Sans MS' }
        ];

        const BeadColors = Array.from({length: 30}, (_, i) => ({name: `Boja ${i+1}`, value: `Boja ${i+1}`}));
        const VikBeadColors = Array.from({length: 43}, (_, i) => ({name: `Viktorija (${i+1}).jpeg`, value: `Viktorija (${i+1}).jpeg`}));
        const DeliveryOptions = [
            { value: 'Boxnow', label: 'Boxnow paketomat 4€' },
            { value: 'GLS_paketomat', label: 'GLS paketomat 7€' },
            { value: 'GLS_kucna_adresa', label: 'GLS kućna adresa 7€' }
        ];

        const imageSelections = {
            bojaSeta: ['Srebrna.jpeg', 'Zlatna.jpeg', 'Roza.jpeg'],
            fontoviZaKrsniSet: [
                'TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg',
                'TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg',
                'TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg',
            ],
            bojeVrpca: [
                'Plava-svijetla.jpeg', 'Roza-prasasta-1.jpeg', 'Smeda-tamna.jpeg', 'Bijela.jpeg',
                'Bijela-topla.jpeg', 'Krem.jpeg', 'Zlatna-tamna.jpeg', 'Zlatna-svijetla.jpeg',
                'Roza-prasasta-2.jpeg', 'Rose-gold.jpeg', 'Mauve.jpeg', 'Breskvasta.jpeg',
                'Lila-svijetla.jpeg', 'Roza-svijetla-1.jpeg', 'Ljubicasta.jpeg', 'Taupe.jpeg',
                'Plava-kraljevska-1.jpeg', 'Roza-srednja.jpeg', 'Roza-bijela.jpeg', 'Breskvasta-svijetla.jpeg',
                'Roza-lila.jpeg', 'Mint.jpeg', 'Zelena-maslinasta-svijetla.jpeg', 'Khaki.jpeg',
                'Mint-svijetla.jpeg', 'Zelena-tamna.jpeg', 'Zelena-petrolej.jpeg', 'Plava-kraljevska-2.jpeg',
                'Teget-tamna.jpeg', 'Teget-svijetla.jpeg', 'Plava-jarka.jpeg',
            ],
            krila: ['Ne.jpeg', 'Da.jpeg'],
            bojuPerlicaKrunice: [
                'TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg',
                'TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg',
                'TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg','TestSlika.jpeg',
            ],
        };

        function attachModalHandlers() {
            document.querySelectorAll('.option-card, .option-image').forEach(card => {
                card.addEventListener('click', function(this: HTMLElement) {
                    const field = this.dataset.field;
                    const value = this.dataset.value;
                    if (!field || !value) return;
                    const input = getElement<HTMLInputElement>(`${field}Input`);
                    if (!input) return;
                    input.value = value;
                    // Remove selected from both option-card and option-image with same field
                    document.querySelectorAll<HTMLElement>(`.option-card[data-field="${field}"], .option-image[data-field="${field}"]`).forEach(c => c.classList.remove('selected'));
                    this.classList.add('selected');

                    if (field === 'par') {
                        const bazaShow = value !== 'Samo nadopuna';
                        const nadopunaShow = value !== 'Samo baza';
                        const bazaSection = getElement('bazaSection');
                        const nadopunaSection = getElement('nadopunaSection');
                        if (bazaSection) bazaSection.style.display = bazaShow ? 'block' : 'none';
                        if (nadopunaSection) nadopunaSection.style.display = nadopunaShow ? 'block' : 'none';
                    }
                    if (field === 'deliveryMethod') {
                        updateDeliverySelection(value);
                    }
                });
            });

            document.querySelectorAll('select').forEach(select => {
                select.addEventListener('change', function(this: HTMLSelectElement) {
                    const field = this.dataset.field;
                    const value = this.value;
                    if (!field || !value) return;
                    const input = getElement<HTMLInputElement>(`${field}Input`);
                    if (input) input.value = value;

                    if (field === 'krunica') {
                        const section = getElement('krunicaSection');
                        if (section) section.style.display = value === 'Da' ? 'block' : 'none';
                        if (value === 'Ne') {
                            const beadColorInput = getElement<HTMLInputElement>('boja_perlicaInput');
                            if (beadColorInput) beadColorInput.value = '';
                        }
                    }
                    if (field === 'biblija') {
                        const section = getElement('biblijaSection');
                        if (section) section.style.display = value !== 'Ne' ? 'block' : 'none';
                        const bibleNameSelect = getElement<HTMLSelectElement>('biblijaSaImenomSelect');
                        if (bibleNameSelect) {
                            bibleNameSelect.required = value !== 'Ne';
                            if (value === 'Ne') bibleNameSelect.value = '';
                        }
                        if (value === 'Ne') {
                            const bibleNameInput = getElement<HTMLInputElement>('biblija_sa_imenomInput');
                            if (bibleNameInput) bibleNameInput.value = '';
                        }
                    }
                });
            });

            document.querySelectorAll('.cancel-modal-btn').forEach(btn => {
                btn.addEventListener('click', closeCustomizationModal);
            });

            const krsniForm = document.getElementById('krsniSetForm');
            if (krsniForm) {
                krsniForm.addEventListener('submit', submitKrsniSet);
            }

            const vikForm = document.getElementById('vikForm');
            if (vikForm) {
                vikForm.addEventListener('submit', submitViktorija);
            }

            const simpleForm = document.getElementById('customSimpleForm');
            if (simpleForm) {
                const productName = simpleForm.dataset.productName ?? '';
                simpleForm.addEventListener('submit', (e) => submitSimpleProduct(e, productName));
            }
        }

        function updateDeliverySelection(value: string) {
            const deliveryMethodInput = getElement<HTMLInputElement>('deliveryMethodInput');
            if (deliveryMethodInput) deliveryMethodInput.value = value;
            const boxnowButton = document.getElementById('chooseLockerBoxnowButton');
            const glsButton = document.getElementById('open-gls');
            const addressInput = document.getElementById('deliveryAddressInput') as HTMLInputElement | null;
            if (boxnowButton && glsButton) {
                boxnowButton.style.display = value === 'Boxnow' ? 'inline-flex' : 'none';
                glsButton.style.display = value === 'GLS_paketomat' ? 'inline-flex' : 'none';
            }
            if (addressInput) {
                addressInput.placeholder = value === 'GLS_kucna_adresa' ? 'Upišite adresu za dostavu na kućnu adresu' : 'Odaberite BoxNow paketomat';
            }
        }

        function openKrsniSetModal() {
            getRequiredElement('modalContent').innerHTML = getKrsniSetForm();
            getRequiredElement('customizationModal').classList.add('active');
            document.body.style.overflow = 'hidden';
            attachModalHandlers();
        }

        function openViktorijaNausnicasModal() {
            getRequiredElement('modalContent').innerHTML = getViktorijaNausnicasForm();
            getRequiredElement('customizationModal').classList.add('active');
            document.body.style.overflow = 'hidden';
            attachModalHandlers();
        }

        function openSimpleProductModal(productName: string) {
            getRequiredElement('modalContent').innerHTML = getSimpleProductForm(productName);
            getRequiredElement('customizationModal').classList.add('active');
            document.body.style.overflow = 'hidden';
            attachModalHandlers();
        }

        function getKrsniSetForm() {
            return `
                <h3 style="color: var(--llt-accent-mid);">Prilagodi Krsni Set</h3>
                <form id="krsniSetForm">
                    <div class="mb-3">
                        <label class="form-label" style="color: var(--llt-accent-dark);">Boja krsnog seta:</label>
                        <input type="hidden" name="boja_seta" id="boja_setaInput" data-required-image="Boja krsnog seta">
                        <div class="selection-grid mt-2">
                            ${imageSelections.bojaSeta.map(img => `<img src="../images/BojaSeta/${img}" data-field="boja_seta" data-value="${img.replace(/\.(jpg|jpeg|png|gif|webp)$/i, '')}" class="option-image" alt="${img}">`).join('')}
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="color: var(--llt-accent-dark);">Poruka na vanjskom dijelu kutije(ime):</label>
                        <input type="text" name="vanjski_dio_kutije" class="form-control" required style="border: 1px solid var(--llt-accent-mid);">
                    </div>

                    <div class="border-top border-bottom py-3 my-3">
                        <h5 style="color: var(--llt-accent-mid);">Svijeća</h5>
                        <div class="mb-3">
                            <label for="bojaSvijeceSelect" class="form-label" style="color: var(--llt-accent-dark);">Boja svijeće:</label>
                            <input type="hidden" name="boja_svijece" id="boja_svijeceInput">
                            <select id="bojaSvijeceSelect" class="form-control" data-field="boja_svijece" required style="border: 1px solid var(--llt-accent-mid); color: var(--llt-accent-dark);">
                                <option value="" disabled selected>-- Odaberi --</option>
                                <option value="Bijela">Bijela</option>
                                <option value="Srebrna">Srebrna</option>
                                <option value="Zlatna">Zlatna</option>
                                <option value="Roza">Roza</option>
                                <option value="Plava">Plava</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: var(--llt-accent-dark);">Boja vrpce:</label>
                            <input type="hidden" name="boja_vrpce" id="boja_vrpceInput" data-required-image="Boja vrpce">
                            <div class="selection-grid mt-2">
                                ${imageSelections.bojeVrpca.map(img => `<img src="../images/BojaVrpce/${img}" data-field="boja_vrpce" data-value="${img.replace(/\.(jpg|jpeg|png|gif|webp)$/i, '')}" class="option-image" alt="${img}">`).join('')}
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: var(--llt-accent-dark);">Krila na svijeći:</label>
                            <input type="hidden" name="krila" id="krilaInput" data-required-image="Krila na svijeći">
                            <div class="selection-grid mt-2">
                                ${imageSelections.krila.map(img => `<img src="../images/KrilaNaSvijeci/${img}" data-field="krila" data-value="${img.replace(/\.(jpg|jpeg|png|gif|webp)$/i, '')}" class="option-image" alt="${img}">`).join('')}
                            </div>
                        </div>
                    </div>

                    <div class="border-bottom py-3 my-3">
                        <h5 style="color: var(--llt-accent-mid);">Unutrašnjost kutije</h5>
                        <div class="mb-3">
                            <label class="form-label" style="color: var(--llt-accent-dark);">Poruka na sredini kutije (max 300 znakova):</label>
                            <textarea name="poruka_sredina" class="form-control" maxlength="300" rows="2" required style="border: 1px solid var(--llt-accent-mid);"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: var(--llt-accent-dark);">Font sredina:</label>
                            <input type="hidden" name="font_sredina" id="font_sredinaInput" data-required-image="Font sredina">
                            <div class="selection-grid mt-2">
                                ${imageSelections.fontoviZaKrsniSet.map(img => `<img src="../images/fontoviZaKrsniSet/${img}" data-field="font_sredina" data-value="${img.replace(/\.(jpg|jpeg|png|gif|webp)$/i, '')}" class="option-image" alt="${img}">`).join('')}
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: var(--llt-accent-dark);">Posveta (max 300 znakova):</label>
                            <textarea name="posveta" class="form-control" maxlength="300" rows="2" required style="border: 1px solid var(--llt-accent-mid);"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" style="color: var(--llt-accent-dark);">Font dolje:</label>
                            <input type="hidden" name="font_dolje" id="font_doljeInput" data-required-image="Font dolje">
                            <div class="selection-grid mt-2">
                                ${imageSelections.fontoviZaKrsniSet.map(img => `<img src="../images/fontoviZaKrsniSet/${img}" data-field="font_dolje" data-value="${img.replace(/\.(jpg|jpeg|png|gif|webp)$/i, '')}" class="option-image" alt="${img}">`).join('')}
                            </div>
                        </div>
                    </div>

                    <div class="border-bottom py-3 my-3">
                        <h5 style="color: var(--llt-accent-mid);">Majica</h5>
                        <div class="mb-3">
                            <label class="form-label" style="color: var(--llt-accent-dark);">Odabir za majicu:</label>
                            <select name="stil_majice" class="form-control" required style="border: 1px solid var(--llt-accent-mid); color: var(--llt-accent-dark);">
                                <option value="" disabled selected>-- Odaberi --</option>
                                <option value="Ime">Ime</option>
                                <option value="Krizic">Krizic</option>
                                <option value="Krizic + ime">Krizic + ime</option>
                                <option value="Krizic + ime + od danas si dijete Bozje">Krizic + ime + od danas si dijete Bozje</option>
                            </select>
                        </div>
                    </div>

                    <div class="border-bottom py-3 my-3">
                        <h5 style="color: var(--llt-accent-mid);">Maramica</h5>
                        <select name="stil_maramice" id="stil_maramiceInput" class="form-control" required style="border: 1px solid var(--llt-accent-mid); color: var(--llt-accent-dark);">
                            <option value="" disabled selected>-- Odaberi --</option>
                            <option value="Krizic">Krizic</option>
                            <option value="Ime">Ime</option>
                            <option value="Ime i krizic">Ime i krizic</option>
                        </select>
                    </div>

                    <div class="border-bottom py-3 my-3">
                        <h5 style="color: var(--llt-accent-mid);">Krunica</h5>
                        <input type="hidden" name="krunica" id="krunicaInput">
                        <select class="form-control" data-field="krunica" required style="border: 1px solid var(--llt-accent-mid); color: var(--llt-accent-dark);">
                            <option value="" disabled selected>-- Odaberi --</option>
                            <option value="Ne">Ne</option>
                            <option value="Da">Da</option>
                        </select>
                        <div id="krunicaSection" style="display: none; margin-top: 16px;">
                            <label class="form-label" style="color: var(--llt-accent-dark);">Boja perlica:</label>
                            <input type="hidden" name="boja_perlica" id="boja_perlicaInput" data-required-image="Boja perlica">
                            <div class="selection-grid mt-2">
                                ${imageSelections.bojuPerlicaKrunice.map(img => `<img src="../images/bojuPerlicaKrunice/${img}" data-field="boja_perlica" data-value="${img.replace(/\.(jpg|jpeg|png|gif|webp)$/i, '')}" class="option-image" alt="${img}">`).join('')}
                            </div>
                        </div>
                    </div>

                    <div class="border-bottom py-3 my-3">
                        <h5 style="color: var(--llt-accent-mid);">Biblija</h5>
                        <input type="hidden" name="biblija" id="biblijaInput">
                        <select class="form-control" data-field="biblija" required style="border: 1px solid var(--llt-accent-mid); color: var(--llt-accent-dark);">
                            <option value="" disabled selected>-- Odaberi --</option>
                            <option value="Ne">Ne</option>
                            <option value="Mini biblija za djecu">Mini biblija za djecu</option>
